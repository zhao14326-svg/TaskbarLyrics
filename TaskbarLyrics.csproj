<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarLyrics</AssemblyName>
    <RootNamespace>TaskbarLyrics</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Web\overlay.html" LogicalName="TaskbarLyrics.Assets.Web.overlay.html" />
    <EmbeddedResource Include="Assets\Web\overlay.css"  LogicalName="TaskbarLyrics.Assets.Web.overlay.css" />
    <EmbeddedResource Include="Assets\Web\overlay.js"   LogicalName="TaskbarLyrics.Assets.Web.overlay.js" />
    <EmbeddedResource Include="Assets\Fonts\Montserrat.ttf" LogicalName="TaskbarLyrics.Assets.Fonts.Montserrat.ttf" />
    <EmbeddedResource Include="Assets\Fonts\OFL.txt" LogicalName="TaskbarLyrics.Assets.Fonts.OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LyricsTest\**" />
    <EmbeddedResource Remove="LyricsTest\**" />
    <None Remove="LyricsTest\**" />
    <Page Remove="LyricsTest\**" />
  </ItemGroup>

</Project>
